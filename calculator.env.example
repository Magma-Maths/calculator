# Magma execution
MAGMA_ROOT=/opt/magma/current
MAGMA_TIMEOUT=120
MAGMA_CPU_TIMEOUT=120
MAGMA_MEMORY_MB=400
MAGMA_INPUT_KB=50
MAGMA_OUTPUT_KB=20
JAIL_SECCOMP=true

# Execution backend
# "nsjail" (in-container jail) or "firecracker" (talks to the host supervisor; see FIRECRACKER.md)
EXECUTOR_BACKEND=nsjail
# Supervisor UNIX socket, only used when EXECUTOR_BACKEND=firecracker
SUPERVISOR_SOCKET=/run/magma-fc/supervisor.sock

# Service
MAX_CONCURRENT=4
PORT=8080
# Traefik's address in traefik/docker-compose.yml; with your own proxy, use its address
FORWARDED_ALLOW_IPS=172.30.0.2

# Rate limiting
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=200

# CORS
ALLOWED_ORIGIN=*

# Usage logging
USAGE_LOG_FILE=/data/usage.jsonl

# Optional Turnstile
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
