DOMAIN=calc.magma-maths.org

# CALCULATOR_VERSION pins the image tag this host runs, from
# ghcr.io/magma-maths/calculator. sha-<7 hex chars> tags are immutable builds of
# main; v* tags are releases. There is deliberately no default, so a deployment
# always states its version: a moving tag would let a routine pull or restart
# change the running code without anyone choosing it.
CALCULATOR_VERSION=v0.1.0
